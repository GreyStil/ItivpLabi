<section>
  <h2 class="page-title"><%= item.name %></h2>
  <p class="page-subtitle">Кампания #<%= item.id %></p>

  <ul class="detail-list">
    <li><span>Канал</span><span><%= item.channel %></span></li>
    <li><span>Бюджет</span><span><%= item.budget %></span></li>
    <li><span>Потрачено</span><span><%= item.spent %></span></li>
    <li><span>Клики</span><span><%= item.clicks %></span></li>
    <li><span>Конверсии</span><span><%= item.conversions %></span></li>
    <li><span>Доход</span><span><%= item.revenue %></span></li>
    <li><span>CPC</span><span><%= item.cpc %></span></li>
    <li><span>Конверсия</span><span><%= item.conversionRate %> %</span></li>
    <li><span>ROI</span><span><%= item.roi %> %</span></li>
    <li><span>Статус</span><span><%= item.status %></span></li>
  </ul>

  <div class="actions">
    <a class="btn secondary" href="/">← К списку</a>
  </div>
</section>
