<section>
  <h2 class="page-title">Новая кампания</h2>
  <p class="page-subtitle">Доступно только авторизованным пользователям.</p>

  <form class="form-stack" method="post" action="/add" style="max-width:520px">
    <label>Название <input name="name" required /></label>
    <label>Канал <input name="channel" required placeholder="search, social, display" /></label>
    <label>Бюджет <input name="budget" type="number" step="0.01" min="0" /></label>
    <label>Потрачено <input name="spent" type="number" step="0.01" min="0" /></label>
    <label>Клики <input name="clicks" type="number" min="0" /></label>
    <label>Конверсии <input name="conversions" type="number" min="0" /></label>
    <label>Доход <input name="revenue" type="number" step="0.01" min="0" /></label>
    <label>
      Статус
      <select name="status">
        <option value="active">активна</option>
        <option value="paused">приостановлена</option>
      </select>
    </label>
    <div class="actions">
      <button class="btn" type="submit">Сохранить</button>
      <a class="btn secondary" href="/">Отмена</a>
    </div>
  </form>
</section>
