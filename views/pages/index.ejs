<section>
  <h2 class="page-title">Кампании</h2>
  <p class="page-subtitle">Список рекламных кампаний из in-memory хранилища.</p>

  <form class="filter" method="get" action="/">
    <label>Канал <input name="channel" value="<%= filters.channel || '' %>" placeholder="search, social…" /></label>
    <label>Статус <input name="status" value="<%= filters.status || '' %>" placeholder="active, paused…" /></label>
    <button class="btn secondary" type="submit">Фильтр</button>
    <a class="btn secondary" href="/">Сброс</a>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Название</th>
          <th>Канал</th>
          <th>Потрачено</th>
          <th>Клики</th>
          <th>Конверсии</th>
          <th>CPC</th>
          <th>CR %</th>
          <th>ROI %</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!items.length) { %>
          <tr><td colspan="10">Нет кампаний по выбранному фильтру.</td></tr>
        <% } %>
        <% items.forEach(function(c){ %>
          <tr>
            <td><%= c.id %></td>
            <td><strong><%= c.name %></strong></td>
            <td><%= c.channel %></td>
            <td><%= c.spent %></td>
            <td><%= c.clicks %></td>
            <td><%= c.conversions %></td>
            <td><%= c.cpc %></td>
            <td><%= c.conversionRate %></td>
            <td><%= c.roi %></td>
            <td><a class="btn secondary" href="/item/<%= c.id %>">Детали</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (user.authenticated) { %>
    <div class="actions">
      <a class="btn" href="/add">Добавить кампанию</a>
    </div>
  <% } else { %>
    <p class="page-subtitle">Чтобы добавить кампанию, <a href="/login">войдите</a> или <a href="/register">зарегистрируйтесь</a>.</p>
  <% } %>
</section>
