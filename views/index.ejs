<%- include('partials/header') %>

  <section>
    <h2>Кампании</h2>

    <form class="filter" method="get" action="/">
      <label>Канал: <input name="channel" value="<%= filters.channel || '' %>"></label>
      <label>Статус: <input name="status" value="<%= filters.status || '' %>"></label>
      <button class="btn secondary" type="submit">Применить</button>
      <a class="btn" href="/">Сбросить</a>
    </form>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Название</th>
          <th>Канал</th>
          <th>Потрачено</th>
          <th>Клики</th>
          <th>Конверсии</th>
          <th>CPC</th>
          <th>Конверсия %</th>
          <th>ROI %</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(c){ %>
          <tr>
            <td><%= c.id %></td>
            <td><%= c.name %></td>
            <td><%= c.channel %></td>
            <td><%= c.spent %></td>
            <td><%= c.clicks %></td>
            <td><%= c.conversions %></td>
            <td><%= c.cpc %></td>
            <td><%= c.conversionRate %></td>
            <td><%= c.roi %></td>
            <td><a class="btn secondary" href="/item/<%= c.id %>">Открыть</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="actions">
      <a class="btn" href="/add">Добавить кампанию</a>
    </div>
  </section>

<%- include('partials/footer') %>
