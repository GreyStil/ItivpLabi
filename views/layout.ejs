<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= title %> — Аналитика кампаний</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <div class="brand">
          <h1>Аналитика рекламных кампаний</h1>
          <p>ROI, CPC и эффективность кампаний</p>
        </div>
        <div class="topbar">
          <nav>
            <a href="/">Главная</a>
            <% if (user.authenticated) { %>
              <a href="/add">Добавить</a>
            <% } %>
            <% if (!user.authenticated) { %>
              <a href="/login">Вход</a>
              <a href="/register">Регистрация</a>
            <% } %>
          </nav>
          <div class="user-chip">
            <span><%= user.authenticated ? user.email : 'Гость' %></span>
            <% if (user.authenticated && user.role) { %>
              <span class="role"><%= user.role %></span>
            <% } %>
          </div>
          <% if (user.authenticated) { %>
            <form method="post" action="/logout" style="margin:0">
              <button class="btn secondary" type="submit">Выйти</button>
            </form>
          <% } %>
        </div>
      </header>

      <main class="card">
        <%- body %>
      </main>

      <footer class="site-footer">
        <small>Аналитика кампаний © <%= new Date().getFullYear() %></small>
      </footer>
    </div>
  </body>
</html>
