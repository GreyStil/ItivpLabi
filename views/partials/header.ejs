<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Аналитика рекламных кампаний</title>
    <style>
      :root{ --primary:#2b6cb0; --muted:#6b7280; --bg:#f7fafc; --card:#ffffff }
      *{box-sizing:border-box}
      body{font-family:Inter,Segoe UI,Arial,sans-serif;margin:0;background:var(--bg);color:#111}
      .container{max-width:1100px;margin:28px auto;padding:18px}
      header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
      header h1{margin:0;color:var(--primary);font-size:1.5rem}
      nav a{color:var(--primary);text-decoration:none;margin-right:12px}
      .topbar{display:flex;gap:12px;align-items:center}
      .card{background:var(--card);border-radius:8px;padding:16px;box-shadow:0 1px 3px rgba(16,24,40,0.06)}
      table{width:100%;border-collapse:collapse;margin-top:12px}
      th,td{padding:10px;border-bottom:1px solid #eef2f7;text-align:left}
      th{background:#f1f5f9;color:#334155;font-weight:600}
      .btn{display:inline-block;padding:8px 12px;border-radius:6px;background:var(--primary);color:#fff;text-decoration:none}
      .btn.secondary{background:#edf2ff;color:var(--primary);border:1px solid #c7d2fe}
      form.filter{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
      form.filter input, form.filter select{padding:6px 8px;border:1px solid #ddd;border-radius:6px}
      .actions{margin-top:12px}
      @media(max-width:720px){header{flex-direction:column;align-items:flex-start} table{font-size:13px}}
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>Аналитика рекламных кампаний</h1>
        <div class="topbar">
          <div>Привет, <strong><%= user && user.name ? user.name : 'Гость' %></strong></div>
          <nav>
            <a href="/">Главная</a>
            <a href="/add">Добавить кампанию</a>
            <a href="/login">Войти</a>
          </nav>
        </div>
      </header>
      <main class="card">
